rules_version = '2';

// Mailing list inbox. The site's Subscribe form may only add a document holding {email}; nobody can read, change or
// delete anything through the site's key. The Apps Script in apps-script/ moves each signup into the Sheet and deletes
// it, using community@totallytabular.org's own access, which these rules don't limit.
service cloud.firestore {
  match /databases/{database}/documents {
    match /signups/{id} {
      // No leading = + - either: the Sheet would treat those as formulas.
      allow create: if request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('[^\\s@=+-][^\\s@]*@[^\\s@]+[.][^\\s@]{2,}');
    }
  }
}
