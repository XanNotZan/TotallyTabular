rules_version = '2';

// Mailing list inbox. The site may only add documents: a signup holding {email}, or an unsubscribe request holding the
// {token} from a subscriber's emails. Nobody can read, change or delete anything. The Apps Script in apps-script/
// processes and deletes them, using community@totallytabular.org's own access, which these rules don't limit.
service cloud.firestore {
  match /databases/{database}/documents {
    match /signups/{id} {
      // No leading = + - either: the Sheet would treat those as formulas.
      allow create: if request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('[^\\s@=+-][^\\s@]*@[^\\s@]+[.][^\\s@]{2,}');
    }
    match /unsubscribes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}');
    }
  }
}
